{
  "name": "repona",
  "private": true,
  "scripts": {
    "build": "PYTHONPATH=backend .venv/bin/python -m compileall -q backend/app",
    "verify:postgres": "PYTHONPATH=backend .venv/bin/python scripts/verify_neon_postgres.py",
    "verify:qdrant": "PYTHONPATH=backend .venv/bin/python scripts/verify_qdrant.py",
    "benchmark": "PYTHONPATH=backend .venv/bin/python scripts/benchmark.py --output evaluation/benchmark-latest.json",
    "benchmark:suite": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_suite.py --index --output evaluation/benchmark-suite-latest.json",
    "benchmark:suite:measure": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_suite.py --skip-index --output evaluation/benchmark-suite-latest.json",
    "benchmark:detailed": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_detailed.py --output evaluation/benchmark-detailed-latest.json --markdown evaluation/benchmark-detailed-report.md",
    "benchmark:large-index": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_index_large.py",
    "benchmark:controlled": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_controlled.py --mode all",
    "benchmark:controlled:lazy-cold": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_controlled.py --mode lazy_cold",
    "benchmark:controlled:progressive-cold": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_controlled.py --mode progressive_cold",
    "benchmark:controlled:full-cold": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_controlled.py --mode full_cold",
    "benchmark:lazy-validation": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_lazy_validation.py",
    "benchmark:router-correctness": "PYTHONPATH=backend .venv/bin/python scripts/benchmark_router_correctness.py",
    "benchmark:compare": "PYTHONPATH=backend .venv/bin/python scripts/compare_retrieval_paths.py",
    "e2e:smoke": "PYTHONPATH=backend .venv/bin/python scripts/e2e_smoke.py --base-url http://127.0.0.1:8000",
    "repair:catalog": "PYTHONPATH=backend .venv/bin/python scripts/repair_catalog.py --all --reset-expired-refresh",
    "start": "PYTHONPATH=backend .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  }
}
