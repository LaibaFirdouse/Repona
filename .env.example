APP_NAME=Repository Intelligence Agent API
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/repo_intelligence
# A question may set provider to cursor, claude, codex, ollama, opencode, zai, or copilot.
LLM_PROVIDER=cursor
CURSOR_MODEL=composer-2.5-fast
CURSOR_TIMEOUT=180
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT=180
OPENCODE_MODEL=opencode/big-pickle
OPENCODE_TIMEOUT=180
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
ZAI_TIMEOUT=60
COPILOT_MODEL=auto
COPILOT_TIMEOUT=180
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=600
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=800
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=repo-intelligence-password
DEBUG=true
