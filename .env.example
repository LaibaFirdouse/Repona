APP_NAME=Repository Intelligence Agent API
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/repona
# Accepted provider. Compose sets the API container to cursor. A host process reads this value.
# openai is valid here. A request may set provider to cursor, claude, codex, copilot, opencode, zai, or ollama.
LLM_PROVIDER=cursor
# Host bridge. The API calls this URL. Compose does not start the bridge.
CURSOR_BRIDGE_URL=http://127.0.0.1:8765
# Required. At least 16 characters. The bridge process and the API must use the same value.
# This authenticates calls to the bridge. It is not a login for the page or the API.
CURSOR_BRIDGE_TOKEN=
CURSOR_MODEL=composer-2.5-fast
CURSOR_TIMEOUT=180
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT=180
OPENCODE_MODEL=opencode/big-pickle
OPENCODE_TIMEOUT=180
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
ZAI_TIMEOUT=60
COPILOT_MODEL=auto
COPILOT_TIMEOUT=180
# Tokens left unused so the prompt plus the output budget do not fill the window.
CONTEXT_MARGIN_TOKENS=256
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=800
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=repo-intelligence-password
DEBUG=true
# Opt-in log when a model body produces no cited claim. Unset leaves responses unchanged.
# CLAIM_DIAGNOSTICS=true
# Include a redacted excerpt of the model body. Requires CLAIM_DIAGNOSTICS.
# CLAIM_DIAGNOSTICS_RAW=true
