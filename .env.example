APP_NAME=Repository Intelligence Agent API
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# Local Docker Postgres, or Neon pooled URL from `neon deploy` (postgresql://… is normalized to psycopg).
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/repona
# DATABASE_URL_UNPOOLED=   # Neon direct URL for migrations (optional)
# NEON_BRANCH=production
QDRANT_URL=http://127.0.0.1:6333
# Qdrant Cloud: https cluster URL from the console and an API key from Access / cluster details.
# QDRANT_API_KEY=
# Accepted provider. Compose sets the API container to cursor. A host process reads this value.
# openai is valid here. A request may set provider to cursor, claude, codex, opencode, zai, or ollama.
# copilot is disabled (its CLI runs with --allow-all-tools).
LLM_PROVIDER=cursor
# Public hosting: set on the server only. Generate at Cursor Dashboard → API Keys (crsr_…).
# CURSOR_API_KEY=
# Local dev with Docker: host bridge. Leave unset on public hosting (API runs agent in-process).
CURSOR_BRIDGE_URL=http://127.0.0.1:8765
# Required. At least 16 characters. The bridge process and the API must use the same value.
# This authenticates calls to the bridge. It is not a login for the page or the API.
CURSOR_BRIDGE_TOKEN=
# Cursor CLI processes the bridge runs at once; further requests wait.
# CURSOR_BRIDGE_MAX_CONCURRENT=4
CURSOR_MODEL=composer-2.5-fast
CURSOR_TIMEOUT=180
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT=180
OPENCODE_MODEL=opencode/big-pickle
OPENCODE_TIMEOUT=180
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
ZAI_TIMEOUT=60
COPILOT_MODEL=auto
COPILOT_TIMEOUT=180
# Tokens left unused so the prompt plus the output budget do not fill the window.
CONTEXT_MARGIN_TOKENS=256
# Optional Ollama. Selecting provider=ollama does not imply the Qwen tokenizer.
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_NUM_CTX=4096
# OLLAMA_TOKENIZER=auto   # auto | qwen2.5 | conservative
#   auto: Qwen chat tokenizer only for verified tags (qwen2.5:1.5b, qwen2.5:1.5b-instruct);
#   other Ollama models use the same conservative byte estimate as Cursor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
# Output cap for every provider (the name is historical). Truncated JSON answers are discarded, so keep it generous.
OPENAI_MAX_OUTPUT_TOKENS=2000
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=repo-intelligence-password
# Large repos: skip full git tree validation on each ask (HEAD check only). Set false for strict byte-for-byte checks.
# RETRIEVAL_LIGHT_SNAPSHOT_VALIDATE=true
# Omit Qdrant file_id filter when a generation has more than this many files (Postgres still filters hits).
# RETRIEVAL_VECTOR_MAX_FILE_FILTER=256
# Warm the embedding model on API startup so the first ask is not cold.
# EMBED_WARMUP_ON_STARTUP=true
# Off by default: an extra LLM call per question before retrieval. Heuristic routing is used instead.
# QUERY_PLANNER_ENABLED=false
# Lazy indexing: store every chunk with full-text search at index time, embed function bodies on first use.
# PROGRESSIVE_INDEXING=true
# PROGRESSIVE_STORE_DEFERRED_CHUNKS=true
# EMBED_CATALOGUE_BEFORE_ACTIVATE=true
# PROGRESSIVE_COMPLETE_DEFERRED_IN_INGEST=false
# LAZY_EMBED_ON_QUERY=true
DEBUG=true
# Per-IP limits on POST /api/v1/ask and POST /api/v1/repository (on by default).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TRUST_PROXY=false
# RATE_LIMIT_ASK_PER_MINUTE=12
# RATE_LIMIT_INDEX_PER_HOUR=360
# Required to read GET /api/v1/logs when APP_ENV is not local (Compose sets production).
# SERVER_LOGS_TOKEN=
# Anonymous browser sessions (no login): sliding TTL for repos + chat per client_id.
# CLIENT_SESSION_TTL_HOURS=48
# Set true only when the site is served over HTTPS (cookies won't stick on plain HTTP if true).
# CLIENT_COOKIE_SECURE=false
# Opt-in log when a model body produces no cited claim. Unset leaves responses unchanged.
# CLAIM_DIAGNOSTICS=true
# Include a redacted excerpt of the model body. Requires CLAIM_DIAGNOSTICS.
# CLAIM_DIAGNOSTICS_RAW=true
