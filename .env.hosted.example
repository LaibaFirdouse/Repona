# Copy to .env on the EC2 host: cp .env.hosted.example .env
# Required
CURSOR_API_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/repona?sslmode=require
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
NEO4J_URI=bolt+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional
CURSOR_MODEL=composer-2.5-fast
CREDENTIAL_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_ASK_PER_MINUTE=12
RATE_LIMIT_INDEX_PER_HOUR=4
